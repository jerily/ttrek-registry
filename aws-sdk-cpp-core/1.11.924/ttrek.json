{
  "name": "aws-sdk-cpp-core",
  "license": "Apache-2.0",
  "version": "1.11.924",
  "description": "AWS SDK for C++ core and pinned common runtime libraries.",
  "tags": ["cpp", "aws", "cloud", "sdk", "runtime"],
  "url": "https://github.com/aws/aws-sdk-cpp",
  "scripts": {},
  "dependencies": {
    "openssl": "^3.0.13",
    "curl": "^8.7.1"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/aws/aws-sdk-cpp/archive/refs/tags/1.11.924.tar.gz",
        "filename": "aws-sdk-cpp-1.11.924.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-sdk-cpp-1.11.924.tar.gz"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-crt-cpp/archive/refs/tags/v0.44.2.tar.gz",
        "filename": "aws-crt-cpp-v0.44.2.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-crt-cpp-v0.44.2.tar.gz",
        "destination": "crt/aws-crt-cpp"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-auth/archive/refs/tags/v1.0.0.tar.gz",
        "filename": "aws-c-auth-v1.0.0.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-auth-v1.0.0.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-auth"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-cal/archive/refs/tags/v1.0.0.tar.gz",
        "filename": "aws-c-cal-v1.0.0.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-cal-v1.0.0.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-cal"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-common/archive/refs/tags/v1.0.3.tar.gz",
        "filename": "aws-c-common-v1.0.3.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-common-v1.0.3.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-common"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-compression/archive/refs/tags/v1.0.0.tar.gz",
        "filename": "aws-c-compression-v1.0.0.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-compression-v1.0.0.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-compression"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-event-stream/archive/refs/tags/v1.0.0.tar.gz",
        "filename": "aws-c-event-stream-v1.0.0.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-event-stream-v1.0.0.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-event-stream"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-http/archive/refs/tags/v1.1.0.tar.gz",
        "filename": "aws-c-http-v1.1.0.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-http-v1.1.0.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-http"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-io/archive/refs/tags/v1.1.0.tar.gz",
        "filename": "aws-c-io-v1.1.0.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-io-v1.1.0.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-io"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-mqtt/archive/refs/tags/v1.1.2.tar.gz",
        "filename": "aws-c-mqtt-v1.1.2.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-mqtt-v1.1.2.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-mqtt"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-s3/archive/refs/tags/v1.3.1.tar.gz",
        "filename": "aws-c-s3-v1.3.1.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-s3-v1.3.1.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-s3"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-c-sdkutils/archive/refs/tags/v1.0.0.tar.gz",
        "filename": "aws-c-sdkutils-v1.0.0.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-c-sdkutils-v1.0.0.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-c-sdkutils"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-checksums/archive/refs/tags/v1.0.1.tar.gz",
        "filename": "aws-checksums-v1.0.1.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-checksums-v1.0.1.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-checksums"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/aws-lc/archive/refs/tags/v5.11.0.tar.gz",
        "filename": "aws-lc-v5.11.0.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "aws-lc-v5.11.0.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/aws-lc"
      },
      {
        "cmd": "download",
        "url": "https://github.com/awslabs/s2n/archive/refs/tags/v1.7.11.tar.gz",
        "filename": "s2n-v1.7.11.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "s2n-v1.7.11.tar.gz",
        "destination": "crt/aws-crt-cpp/crt/s2n"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "ON"
          },
          {
            "name": "CMAKE_BUILD_TYPE",
            "value": "Release"
          },
          {
            "name": "CMAKE_MODULE_PATH",
            "value": "$SOURCE_DIR/crt/aws-crt-cpp/crt/aws-c-common/cmake"
          },
          {
            "name": "BUILD_ONLY",
            "value": "core"
          },
          {
            "name": "ENABLE_TESTING",
            "value": "OFF"
          },
          {
            "name": "AUTORUN_UNIT_TESTS",
            "value": "OFF"
          },
          {
            "name": "ENFORCE_SUBMODULE_VERSIONS",
            "value": "OFF"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "OFF",
            "if": "+static"
          },
          {
            "name": "CMAKE_POSITION_INDEPENDENT_CODE",
            "value": "ON"
          },
          {
            "name": "AWS_SDK_ADDITIONAL_LIBRARIES",
            "value": "$INSTALL_DIR/lib/libssl.a;$INSTALL_DIR/lib/libcrypto.a",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "config": "Release",
        "parallel": true
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
