--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -352,8 +352,10 @@
         add_subdirectory(tests/performance-tests)
     endif()
 
-    # for user friendly cmake usage
-    include(setup_cmake_find_module)
+    # The core package alone owns the shared AWSSDK discovery files.
+    if(NOT TTREK_BUILD_SERVICE)
+        include(setup_cmake_find_module)
+    endif()
 
     # for generating make uninstall target
     if (NOT TARGET uninstall)
--- a/cmake/sdks.cmake
+++ b/cmake/sdks.cmake
@@ -191,6 +191,26 @@
     foreach (SDK IN LISTS SDK_DEPENDENCY_BUILD_LIST)
         list(APPEND SDK_BUILD_LIST "${SDK}")
     endforeach()
+endif()
+
+# Registry service packages reuse the exact installed core and service dependencies.
+if(TTREK_BUILD_SERVICE)
+    if(BUILD_DEPS OR NOT BUILD_ONLY STREQUAL TTREK_BUILD_SERVICE OR ENABLE_TESTING)
+        message(FATAL_ERROR "TTREK_BUILD_SERVICE requires BUILD_DEPS=OFF, ENABLE_TESTING=OFF, and matching BUILD_ONLY")
+    endif()
+    get_dependencies_for_sdk(${TTREK_BUILD_SERVICE} TTREK_SDK_DEPENDENCIES)
+    string(REPLACE "," ";" TTREK_SDK_DEPENDENCIES "${TTREK_SDK_DEPENDENCIES}")
+    find_package(AWSSDK ${PROJECT_VERSION} EXACT REQUIRED)
+    foreach(TTREK_SDK_DEPENDENCY IN LISTS TTREK_SDK_DEPENDENCIES)
+        find_package(aws-cpp-sdk-${TTREK_SDK_DEPENDENCY} ${PROJECT_VERSION} EXACT REQUIRED CONFIG)
+    endforeach()
+    get_target_property(TTREK_CORE_TYPE aws-cpp-sdk-core TYPE)
+    if((BUILD_SHARED_LIBS AND NOT TTREK_CORE_TYPE STREQUAL "SHARED_LIBRARY") OR
+       (NOT BUILD_SHARED_LIBS AND NOT TTREK_CORE_TYPE STREQUAL "STATIC_LIBRARY"))
+        message(FATAL_ERROR "Service and installed core must use the same BUILD_SHARED_LIBS setting")
+    endif()
+    set(SDK_BUILD_LIST ${TTREK_BUILD_SERVICE})
+    set(SDK_DEPENDENCY_BUILD_LIST "")
 endif()
 
 if (BUILD_BENCHMARKS)
--- a/toolchains/cmakeProjectConfig.cmake
+++ b/toolchains/cmakeProjectConfig.cmake
@@ -1 +1,5 @@
+include(CMakeFindDependencyMacro)
+foreach(_aws_sdk_dependency IN ITEMS @PROJECT_LIBS@)
+    find_dependency(${_aws_sdk_dependency} @PROJECT_VERSION@ EXACT CONFIG)
+endforeach()
 include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")
--- a/toolchains/core-config.cmake
+++ b/toolchains/core-config.cmake
@@ -1,4 +1,17 @@
 include(CMakeFindDependencyMacro)
+if(@ENABLE_ZLIB_REQUEST_COMPRESSION@)
+    find_dependency(ZLIB)
+endif()
+if(@ENABLE_CURL_CLIENT@)
+    find_dependency(CURL)
+    if(NOT @BUILD_SHARED_LIBS@)
+        find_dependency(OpenSSL)
+        set_property(TARGET CURL::libcurl APPEND PROPERTY INTERFACE_LINK_LIBRARIES OpenSSL::SSL OpenSSL::Crypto)
+        if(TARGET ZLIB::ZLIB)
+            set_property(TARGET CURL::libcurl APPEND PROPERTY INTERFACE_LINK_LIBRARIES ZLIB::ZLIB)
+        endif()
+    endif()
+endif()
 # Auto resolve BUILD_SHARED_LIBS for dependencies, could be overrided by CRT_BUILD_SHARED_LIBS
 set(BUILD_SHARED_LIBS_PREV ${BUILD_SHARED_LIBS})
 if (DEFINED CRT_BUILD_SHARED_LIBS)
@@ -17,3 +30,7 @@
 endif()
 set(BUILD_SHARED_LIBS ${BUILD_SHARED_LIBS_PREV})
 include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")
+
+if(TARGET CURL::libcurl)
+    set_property(TARGET aws-cpp-sdk-core APPEND PROPERTY INTERFACE_LINK_LIBRARIES CURL::libcurl)
+endif()
