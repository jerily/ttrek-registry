{
	"name": "aws-sdk-cpp",
	"description": "C++ client libraries for AWS services.",
	"version": "1.11.921",
	"scripts": {
	},
	"dependencies":	{
		"openssl": "^3.0.13",
		"curl": "^8.7.1"
	},
	"devDependencies": {
	},
	"build": {
		"default": [
			{
				"cmd": "git",
				"url": "https://github.com/aws/aws-sdk-cpp",
				"branch": "1.11.921",
				"recurse-submodules": true,
				"shallow-submodules": true
			},
			{ "cmd": "cd" },
			{
				"cmd": "cmake_config",
				"options": [
					{"name": "BUILD_SHARED_LIBS", "value": "ON"},
					{"name": "CMAKE_BUILD_TYPE", "value": "Release"},
					{"name": "CMAKE_MODULE_PATH", "value": "$SOURCE_DIR/crt/aws-crt-cpp/crt/aws-c-common/cmake"},
					{"name": "BUILD_ONLY", "value": "s3;dynamodb;lambda;sqs;iam;transfer;sts;ssm;kms"},
					{"name": "ENABLE_TESTING", "value": "OFF"},
					{"name": "AUTORUN_UNIT_TESTS", "value": "OFF"},
					{"name": "BUILD_SHARED_LIBS", "value": "OFF", "if": "+static"},
					{"name": "CMAKE_POSITION_INDEPENDENT_CODE", "value": "ON"}
				]
			},
			{ "cmd": "cmake_make", "config": "Release", "parallel": true },
			{ "cmd": "cmake_install", "config": "Release" }
		]
	}
}
