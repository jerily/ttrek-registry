{
  "name": "example-community",
  "version": "0.1.8",
  "scripts": {
    "start": {
      "file": "start.sh"
    }
  },
  "dependencies": {
    "tcl": ">=9.1.0,<10.0.0",
    "web-user": "=0.1.6",
    "web-forum": "=0.1.7",
    "twebserver": "^1.47.56",
    "web-wiki": "=0.1.2",
    "web-blog": "=0.1.2",
    "tconfig": "1.0.0"
  },
  "devDependencies": {},
  "description": "Community example mounting accounts, Markdown forum, wiki and blog.",
  "url": "https://github.com/jerily/example-community",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/example-community/releases/download/v0.1.8/example-community-0.1.8.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
