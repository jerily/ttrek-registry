{
  "name": "example-community",
  "license": "MIT",
  "version": "0.3.2",
  "scripts": {
    "start": {
      "file": "start.sh"
    }
  },
  "dependencies": {
    "tpersist": "^0.1.5",
    "tcl": ">=9.1.0,<10.0.0",
    "web-user": "=0.5.3",
    "web-forum": "=0.3.0",
    "twebserver": "^1.47.58",
    "web-wiki": "=0.1.5",
    "web-blog": "=0.1.5",
    "tconfig": "1.0.2",
    "web-static-wiki": "=0.1.10",
    "tpathexp": "^1.2.0",
    "pure-tcl-aws-ses": "^1.0.0",
    "pure-tcl-aws-sqs": "^1.0.0"
  },
  "devDependencies": {},
  "description": "Community site with accounts, editorial permissions, moderated discussions, wiki, and blog.",
  "languages": [
    "TCL"
  ],
  "tags": [
    "tcl",
    "example",
    "web",
    "community",
    "forum",
    "wiki",
    "blog"
  ],
  "url": "https://github.com/jerily/example-community",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/example-community/archive/refs/tags/v0.3.2.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
