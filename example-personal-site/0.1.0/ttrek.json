{
  "name": "example-personal-site",
  "version": "0.1.0",
  "scripts": {
    "start": {
      "file": "start.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.0,<10.0.0",
    "twebserver": "^1.47.55",
    "web-wiki": "0.1.0",
    "web-blog": "0.1.0",
    "tpersist": "^0.1.0",
    "tpathexp": "^1.1.0",
    "jinja2-tcl": "^0.1.0",
    "tjson": "^1.0.26",
    "tdbcsqlite3": ">=1.1.8"
  },
  "devDependencies": {},
  "description": "Local personal-site example using twebserver, web-wiki, web-blog, and SQLite.",
  "build": {
    "default": [
      {
        "cmd": "git",
        "url": "https://github.com/jerily/example-personal-site.git",
        "branch": "v0.1.0"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
