{
  "name": "ksuid-tcl",
  "license": "MIT",
  "description": "Generation and parsing of sortable unique identifiers for Tcl.",
  "tags": ["tcl", "identifiers", "ksuid", "sorting"],
  "url": "https://github.com/jerily/ksuid-tcl",
  "version": "1.0.4",
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.14"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/ksuid-tcl/archive/refs/tags/v1.0.4.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "TCL_LIBRARY_DIR",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "TCL_INCLUDE_PATH",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "OFF",
            "if": "+static"
          },
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
