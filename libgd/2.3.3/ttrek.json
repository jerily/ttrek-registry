{
  "name": "libgd",
  "license": "GD",
  "description": "GD graphics drawing library with PNG, JPEG, GIF, and FreeType support.",
  "tags": [
    "c",
    "graphics",
    "images",
    "png",
    "jpeg",
    "gif"
  ],
  "url": "https://libgd.github.io/",
  "version": "2.3.3",
  "scripts": {},
  "dependencies": {
    "zlib": "^1.3.2",
    "libpng": "^1.6.59",
    "libjpeg-turbo": "^3.2.1",
    "libfreetype": "^2.15.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/libgd/libgd/releases/download/gd-2.3.3/libgd-2.3.3.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "CMAKE_BUILD_TYPE",
            "value": "Release"
          },
          {
            "name": "CMAKE_INSTALL_LIBDIR",
            "value": "lib"
          },
          {
            "name": "CMAKE_POSITION_INDEPENDENT_CODE",
            "value": "ON"
          },
          {
            "name": "CMAKE_PREFIX_PATH",
            "value": "$INSTALL_DIR"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "ON"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "OFF",
            "if": "+static"
          },
          {
            "name": "BUILD_STATIC_LIBS",
            "value": "OFF"
          },
          {
            "name": "BUILD_STATIC_LIBS",
            "value": "ON",
            "if": "+static"
          },
          {
            "name": "BUILD_TEST",
            "value": "OFF"
          },
          {
            "name": "ENABLE_GD_FORMATS",
            "value": "ON"
          },
          {
            "name": "ENABLE_PNG",
            "value": "ON"
          },
          {
            "name": "ENABLE_JPEG",
            "value": "ON"
          },
          {
            "name": "ENABLE_FREETYPE",
            "value": "ON"
          },
          {
            "name": "ENABLE_CPP",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "parallel": true
      },
      {
        "cmd": "cmake_install"
      }
    ]
  }
}
