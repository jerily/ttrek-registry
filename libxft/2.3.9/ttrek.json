{
  "name": "libxft",
  "description": "X11 font rendering library using FreeType and Fontconfig.",
  "tags": ["x11", "fonts", "graphics", "text-rendering"],
  "url": "https://gitlab.freedesktop.org/xorg/lib/libxft",
  "version": "2.3.9",
  "scripts": {},
  "dependencies": {
    "fontconfig": "^2.18.3",
    "libfreetype": "^2.15.0",
    "libxrender": "^0.9.13"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://xorg.freedesktop.org/archive/individual/lib/libXft-2.3.9.tar.xz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "env_variable",
        "name": "CPPFLAGS",
        "op": "prepend",
        "value": "-I$INSTALL_DIR/include"
      },
      {
        "cmd": "env_variable",
        "name": "LDFLAGS",
        "op": "prepend",
        "value": "-L$INSTALL_DIR/lib"
      },
      {
        "cmd": "env_variable",
        "name": "PKG_CONFIG",
        "op": "set",
        "value": "pkg-config --static",
        "if": "+static"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "libdir",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "disable-static"
          },
          {
            "name": "enable-static",
            "if": "+static"
          },
          {
            "name": "disable-shared",
            "if": "+static"
          },
          {
            "name": "with-pic"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
