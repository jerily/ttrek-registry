{
  "name": "libxrender",
  "license": "HPND-sell-variant",
  "description": "Client library for the X11 Render extension.",
  "languages": [
    "C"
  ],
  "tags": [
    "x11",
    "graphics",
    "rendering"
  ],
  "url": "https://gitlab.freedesktop.org/xorg/lib/libxrender",
  "version": "0.9.13",
  "scripts": {},
  "dependencies": {},
  "externalDependencies": {
    "xquartz": {
      "platforms": [
        "darwin"
      ],
      "check": {
        "files": [
          "/opt/X11/include/X11/Xlib.h",
          "/opt/X11/lib/libX11.dylib"
        ]
      },
      "installHint": "brew install --cask xquartz",
      "url": "https://www.xquartz.org/"
    }
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://xorg.freedesktop.org/archive/individual/lib/libXrender-0.9.13.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "patch",
        "filename": "xquartz.diff",
        "p_num": "1"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "env_variable",
        "name": "PKG_CONFIG",
        "op": "set",
        "value": "pkg-config --static",
        "if": "+static"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "libdir",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "disable-static"
          },
          {
            "name": "enable-static",
            "if": "+static"
          },
          {
            "name": "disable-shared",
            "if": "+static"
          },
          {
            "name": "with-pic"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
