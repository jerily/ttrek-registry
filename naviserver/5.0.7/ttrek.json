{
  "name": "naviserver",
  "license": "MPL-2.0",
  "description": "Multithreaded web application server with embedded Tcl.",
  "languages": ["C", "TCL"],
  "tags": ["tcl", "web", "http", "server", "concurrency"],
  "url": "https://github.com/naviserver-project/naviserver",
  "version": "5.0.7",
  "scripts": {
    "start-example": { "file": "start-example.sh" }
  },
  "dependencies": {
    "tcl": ">=8.6.14,<10.0.0",
    "openssl": "^3.5.9",
    "zlib": "^1.3.2"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://downloads.sourceforge.net/project/naviserver/naviserver/5.0.7/naviserver-5.0.7.tar.gz"
      },
      { "cmd": "unpack" },
      { "cmd": "cd", "dirname": "$SOURCE_DIR" },
      {
        "cmd": "configure",
        "options": [
          { "name": "with-tcl", "value": "$INSTALL_DIR/lib" },
          { "name": "with-tclinclude", "value": "$INSTALL_DIR/include" },
          { "name": "with-openssl", "value": "$INSTALL_DIR" },
          { "name": "with-zlib", "value": "$INSTALL_DIR" }
        ]
      },
      { "cmd": "make", "parallel": true },
      { "cmd": "make_install" }
    ]
  }
}
