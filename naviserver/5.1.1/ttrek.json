{
  "name": "naviserver",
  "description": "Multithreaded web application server with embedded Tcl.",
  "version": "5.1.1",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.14,<10.0.0",
    "openssl": "^3.5.9",
    "zlib": "^1.3.2"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://downloads.sourceforge.net/project/naviserver/naviserver/5.1.1/naviserver-5.1.1.tar.gz"
      },
      { "cmd": "unpack" },
      { "cmd": "cd", "dirname": "$SOURCE_DIR" },
      {
        "cmd": "configure",
        "options": [
          { "name": "with-tcl", "value": "$INSTALL_DIR/lib" },
          { "name": "with-openssl", "value": "$INSTALL_DIR" },
          { "name": "with-zlib", "value": "$INSTALL_DIR" }
        ]
      },
      { "cmd": "make", "parallel": true },
      { "cmd": "make_install" }
    ]
  }
}
