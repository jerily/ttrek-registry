{
  "name": "ncurses",
  "version": "6.6.0",
  "description": "Terminal capabilities and character-cell display library.",
  "url": "https://invisible-island.net/ncurses/",
  "license": "MIT",
  "languages": [
    "C"
  ],
  "tags": [
    "terminal",
    "tui"
  ],
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {},
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://ftp.gnu.org/gnu/ncurses/ncurses-6.6.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "env_variable",
        "name": "CPPFLAGS",
        "op": "prepend",
        "value": "-I$INSTALL_DIR/include"
      },
      {
        "cmd": "env_variable",
        "name": "LDFLAGS",
        "op": "prepend",
        "value": "-L$INSTALL_DIR/lib -Wl,-rpath,$INSTALL_DIR/lib"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-shared"
          },
          {
            "name": "without-debug"
          },
          {
            "name": "without-ada"
          },
          {
            "name": "without-cxx"
          },
          {
            "name": "without-cxx-binding"
          },
          {
            "name": "without-tests"
          },
          {
            "name": "without-manpages"
          },
          {
            "name": "enable-widec"
          },
          {
            "name": "enable-overwrite"
          },
          {
            "name": "enable-pc-files"
          },
          {
            "name": "with-pkg-config-libdir",
            "value": "$INSTALL_DIR/lib/pkgconfig"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
