{
  "name": "nssmtpd",
  "license": "MPL-2.0",
  "description": "SMTP server module for NaviServer.",
  "languages": ["C", "TCL"],
  "tags": ["tcl", "naviserver", "smtp", "email", "server"],
  "url": "https://github.com/naviserver-project/nssmtpd",
  "version": "5.1.2",
  "scripts": {},
  "dependencies": {
    "naviserver": "=5.1.2"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://downloads.sourceforge.net/project/naviserver/naviserver/5.1.2/naviserver-5.1.2-modules.tar.gz"
      },
      { "cmd": "unpack" },
      { "cmd": "cd", "dirname": "$SOURCE_DIR/nssmtpd" },
      {
        "cmd": "make",
        "parallel": true,
        "options": [{ "name": "NAVISERVER", "value": "$INSTALL_DIR" }]
      },
      {
        "cmd": "make_install",
        "options": [{ "name": "NAVISERVER", "value": "$INSTALL_DIR" }]
      }
    ]
  }
}
