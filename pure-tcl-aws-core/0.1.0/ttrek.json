{
  "name": "pure-tcl-aws-core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Shared AWS transport, credentials and protocols for Tcl.",
  "languages": [
    "TCL"
  ],
  "url": "https://github.com/jerily/pure-tcl-aws-core",
  "tags": [
    "tcl",
    "aws",
    "core"
  ],
  "scripts": {
    "example-encode": {
      "file": "run-example.sh",
      "args": [
        "encode"
      ]
    }
  },
  "dependencies": {
    "tcl": ">=9.1.0,<10.0.0",
    "trequests": "^1.3.0",
    "tjson": "^1.0.27",
    "tdom": "^0.9.6",
    "tcllib": "^2.0.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/pure-tcl-aws-core/archive/refs/tags/v0.1.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "make_install",
        "options": [
          {
            "name": "PREFIX",
            "value": "$INSTALL_DIR"
          }
        ]
      }
    ]
  }
}
