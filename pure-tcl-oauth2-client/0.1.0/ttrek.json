{
  "name": "pure-tcl-oauth2-client",
  "version": "0.1.0",
  "license": "MIT",
  "dependencies": {
    "tcl": ">=9.1.0,<10.0.0",
    "pure-tcl-oauth2-core": "^0.1.0",
    "trequests": "^1.3.0"
  },
  "devDependencies": {},
  "description": "OAuth2 and OpenID Connect clients for Tcl, including Google Login.",
  "url": "https://github.com/jerily/pure-tcl-oauth2-client",
  "languages": [
    "TCL"
  ],
  "tags": [
    "tcl",
    "oauth2",
    "openid-connect",
    "authentication"
  ],
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/pure-tcl-oauth2-client/archive/refs/tags/v0.1.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
