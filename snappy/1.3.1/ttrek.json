{
  "name": "snappy",
  "description": "Fast compression and decompression library for C and C++.",
  "version": "1.3.1",
  "scripts": {},
  "dependencies": {},
  "devDependencies": {},
  "build": {
    "default": [
      { "cmd": "download", "url": "https://github.com/google/snappy/archive/refs/tags/1.3.1.tar.gz" },
      { "cmd": "unpack" },
      { "cmd": "cd" },
      {
        "cmd": "cmake_config",
        "options": [
          { "name": "CMAKE_BUILD_TYPE", "value": "Release" },
          { "name": "CMAKE_INSTALL_LIBDIR", "value": "lib" },
          { "name": "BUILD_SHARED_LIBS", "value": "OFF" },
          { "name": "CMAKE_POSITION_INDEPENDENT_CODE", "value": "ON" },
          { "name": "SNAPPY_BUILD_TESTS", "value": "OFF" },
          { "name": "SNAPPY_BUILD_BENCHMARKS", "value": "OFF" }
        ]
      },
      { "cmd": "cmake_make", "config": "Release", "parallel": true },
      { "cmd": "cmake_install", "config": "Release" }
    ]
  }
}
