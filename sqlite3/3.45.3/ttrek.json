{
	"name":	"sqlite3",
	"license": "blessing",
	"description": "Embedded SQL database engine with Tcl bindings.",
	"tags": ["tcl", "sqlite", "sql", "database", "embedded"],
	"url": "https://www.sqlite.org/",
	"version":	"3.45.3",
	"scripts":	{
	},
	"dependencies":	{
		"tcl": ">=8.6.14"
	},
	"devDependencies":	{
	},
	"build": {
		"default": [
			{ "cmd": "download", "url": "https://sourceforge.net/projects/tcl/files/Tcl/9.0b3/sqlite3.45.3.tar.gz" },
			{ "cmd": "unpack" },
			{ "cmd": "cd" },
			{
				"cmd": "configure",
				"options": [{"name": "with-tcl", "value": "$INSTALL_DIR/lib"}]
			},
			{ "cmd": "make", "parallel": true },
			{ "cmd": "make_install" }
		]
	}
}