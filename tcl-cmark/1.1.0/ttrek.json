{
  "name": "tcl-cmark",
  "license": "BSD-3-Clause",
  "description": "Tcl bindings for CommonMark and GitHub Flavored Markdown rendering with cmark-gfm.",
  "tags": ["tcl", "markdown", "commonmark", "gfm", "html"],
  "url": "https://github.com/apnadkarni/tcl-cmark",
  "version": "1.1.0",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.14,<10.0.0",
    "cmark-gfm": "0.29.0-gfm.13"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/apnadkarni/tcl-cmark/archive/refs/tags/v1.1.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "with-cmark-gfm",
            "value": "$INSTALL_DIR"
          },
          {
            "name": "disable-shared",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
