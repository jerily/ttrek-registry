{
  "name": "tclgd",
  "license": "BSD-3-Clause AND TCL",
  "description": "Tcl bindings for GD image drawing, manipulation, and encoding.",
  "languages": ["C", "TCL"],
  "tags": [
    "tcl",
    "graphics",
    "images",
    "png",
    "jpeg",
    "gif"
  ],
  "url": "https://github.com/flightaware/tcl.gd",
  "version": "1.4.0",
  "scripts": {
    "demo": {
      "file": "demo.sh"
    },
    "demo-formats": {
      "file": "demo-formats.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.14,<10.0.0",
    "libgd": "^2.3.3"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/flightaware/tcl.gd/archive/refs/tags/v1.4.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "patch",
        "filename": "tcl-version.diff",
        "p_num": "1"
      },
      {
        "cmd": "patch",
        "filename": "darwin-rpath.diff",
        "p_num": "1"
      },
      {
        "cmd": "autogen",
        "path": "autoconf"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "env_variable",
        "name": "GDLIB_CONFIG",
        "value": "$SOURCE_DIR/gdlib-config",
        "op": "set"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "exec-prefix",
            "value": "$INSTALL_DIR"
          },
          {
            "name": "with-tclinclude",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "disable-shared",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
