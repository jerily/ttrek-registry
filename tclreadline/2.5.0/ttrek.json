{
  "name": "tclreadline",
  "version": "2.5.0",
  "description": "GNU Readline editing and history for Tcl shells.",
  "url": "https://github.com/flightaware/tclreadline",
  "license": "BSD-3-Clause",
  "languages": [
    "Tcl",
    "C"
  ],
  "tags": [
    "tcl",
    "readline",
    "terminal"
  ],
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.18,<8.7.0",
    "readline": "^8.3.6"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/flightaware/tclreadline/archive/refs/tags/v2.5.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "env_variable",
        "name": "CPPFLAGS",
        "op": "prepend",
        "value": "-I$INSTALL_DIR/include"
      },
      {
        "cmd": "env_variable",
        "name": "LDFLAGS",
        "op": "prepend",
        "value": "-L$INSTALL_DIR/lib -Wl,-rpath,$INSTALL_DIR/lib"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "with-tcl-includes",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "with-readline-includes",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "with-readline-library",
            "value": "-L$INSTALL_DIR/lib -lreadline -lncursesw"
          },
          {
            "name": "enable-tclstub"
          },
          {
            "name": "without-tk"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
