  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/gregnix/tclutils/archive/9718efd68f9255752e940ca869262e9be85750c3.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "patch",
        "filename": "install.diff",
        "p_num": "1"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "make_install",
        "options": [
          {
            "name": "prefix",
            "value": "$INSTALL_DIR"
          }
        ]
      }
    ]
  }
