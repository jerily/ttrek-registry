{
  "name": "tclvfs",
  "version": "1.4.2",
  "description": "Virtual filesystems implemented in Tcl.",
  "url": "https://core.tcl-lang.org/tclvfs/",
  "license": "TCL",
  "languages": [
    "Tcl",
    "C"
  ],
  "tags": [
    "tcl",
    "filesystem",
    "zip"
  ],
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.18,<8.7.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://deb.debian.org/debian/pool/main/t/tclvfs/tclvfs_1.4.2~20230906.orig.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "download",
        "url": "https://deb.debian.org/debian/pool/main/t/tclvfs/tclvfs_1.4.2~20230906.orig-tclconfig.tar.gz",
        "filename": "tclconfig.tar.gz"
      },
      {
        "cmd": "unpack",
        "filename": "tclconfig.tar.gz",
        "destination": "tclconfig"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "env_variable",
        "name": "CPPFLAGS",
        "op": "prepend",
        "value": "-I$INSTALL_DIR/include"
      },
      {
        "cmd": "env_variable",
        "name": "LDFLAGS",
        "op": "prepend",
        "value": "-L$INSTALL_DIR/lib -Wl,-rpath,$INSTALL_DIR/lib"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
