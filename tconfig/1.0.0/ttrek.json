{
	"name":	"tconfig",
	"description": "Encrypted configuration storage with AWS KMS and SSM integration for Tcl.",
	"version":	"1.0.0",
	"scripts":	{
	},
	"dependencies":	{
		"tink-tcl": ">=20240704.0.0",
		"aws-sdk-tcl-kms": "^1.0.14",
		"aws-sdk-tcl-ssm": "^1.0.14"
	},
	"devDependencies":	{
	},
	"build": {
		"default": [
			{ "cmd": "download", "url": "https://github.com/jerily/tconfig/archive/refs/tags/v1.0.0.tar.gz" },
			{ "cmd":  "unpack" },
			{ "cmd": "cd", "dirname": "$SOURCE_DIR" },
			{ "cmd": "make_install",
				"options": [
					{ "name": "PREFIX", "value": "$INSTALL_DIR" }
				]
			}
		]
	}
}