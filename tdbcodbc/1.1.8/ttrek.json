{
	"name":	"tdbcodbc",
	"license": "TCL",
	"description": "ODBC database driver for Tcl Database Connectivity.",
	"tags": ["tcl", "tdbc", "odbc", "sql", "database"],
	"url": "https://github.com/tcltk/tdbcodbc",
	"version":	"1.1.8",
	"scripts":	{
	},
	"dependencies":	{
		"tcl": ">=8.6.14",
		"tdbc": "=1.1.8"
	},
	"devDependencies":	{
	},
	"build": {
		"default": [
			{ "cmd": "download", "url": "https://sourceforge.net/projects/tcl/files/Tcl/9.0b3/tdbcodbc1.1.8.tar.gz" },
			{ "cmd": "unpack" },
			{ "cmd": "cd" },
			{
				"cmd": "configure",
				"options": [
					{"name": "with-tcl", "value": "$INSTALL_DIR/lib"},
					{"name": "with-tdbc", "value": "$INSTALL_DIR/lib/tdbc1.1.8"}
				]
			},
			{ "cmd": "make", "parallel": true },
			{ "cmd": "make_install" }
		]
	}
}
