{
	"name":	"tdom",
	"description": "XML and HTML parsing, DOM manipulation, and XPath support for Tcl.",
	"tags": ["tcl", "xml", "html", "json", "dom", "xpath", "parsing"],
	"url": "https://tdom.org/",
	"version":	"0.9.3",
	"scripts":	{
	},
	"dependencies":	{
		"tcl": "=9.0.0-beta.1"
	},
	"devDependencies":	{
	},
	"build": {
		"default": [
			{ "cmd": "download", "url": "http://tdom.org/downloads/tdom-0.9.3-src.tar.gz" },
			{ "cmd": "unpack" },
			{ "cmd": "cd", "dirname": "$SOURCE_DIR/unix" },
			{
				"cmd": "configure",
				"path": "../configure",
				"options": [{"name": "with-tcl", "value": "$INSTALL_DIR/lib"}]
			},
			{ "cmd": "make", "parallel": true },
			{ "cmd": "make_install" }
		]
	}
}