{
  "name": "tdom",
  "license": "MPL-2.0",
  "description": "XML and HTML parsing, DOM manipulation, and XPath support for Tcl.",
  "tags": ["tcl", "xml", "html", "json", "dom", "xpath", "parsing"],
  "url": "https://tdom.org/",
  "version": "0.9.6",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.18,<10.0.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://tdom.org/downloads/tdom-0.9.6-src.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "disable-tdomalloc"
          },
          {
            "name": "disable-shared",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
