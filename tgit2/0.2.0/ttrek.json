{
  "name": "tgit2",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Git repositories and linked worktrees for Tcl using libgit2.",
  "languages": [
    "C",
    "TCL"
  ],
  "tags": [
    "tcl",
    "git",
    "version-control"
  ],
  "url": "https://github.com/jerily/tgit2",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.14",
    "libgit2": "^1.9.7"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tgit2/releases/download/v0.2.0/tgit2-0.2.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "CMAKE_BUILD_TYPE",
            "value": "Release"
          },
          {
            "name": "CMAKE_PREFIX_PATH",
            "value": "$INSTALL_DIR"
          },
          {
            "name": "TCL_LIBRARY_DIR",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "TCL_INCLUDE_PATH",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "OFF",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "config": "Release",
        "parallel": true
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
