{
  "name": "tink-tcl",
  "license": "MIT",
  "description": "Tcl bindings for Tink encryption, typed JWTs, signatures, and key management.",
  "languages": [
    "C++",
    "TCL"
  ],
  "tags": [
    "tcl",
    "cryptography",
    "encryption",
    "signatures",
    "security",
    "jwt",
    "oauth2"
  ],
  "url": "https://github.com/jerily/tink-tcl",
  "version": "20240704.0.3",
  "scripts": {},
  "dependencies": {
    "tink-cc": "^2.1.1",
    "tcl": ">=8.6.14",
    "tjson": "^1.0.28"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tink-tcl/archive/refs/tags/v20240704.0.3.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "TCL_LIBRARY_DIR",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "TCL_INCLUDE_PATH",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "TINK_CPP_DIR",
            "value": "$INSTALL_DIR"
          },
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
