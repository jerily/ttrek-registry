{
  "name": "tk",
  "license": "TCL",
  "description": "Cross-platform graphical user interface toolkit for Tcl.",
  "tags": ["tcl", "tk", "gui", "widgets"],
  "url": "https://github.com/tcltk/tk",
  "version": "8.6.18",
  "scripts": {
    "demo-widgets": {
      "file": "demo-widgets.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.18,<8.7.0"
  },
  "externalDependencies": {
    "xquartz": {
      "platforms": [
        "darwin"
      ],
      "check": {
        "files": [
          "/opt/X11/include/X11/Xlib.h",
          "/opt/X11/lib/libX11.dylib"
        ]
      },
      "installHint": "brew install --cask xquartz",
      "url": "https://www.xquartz.org/"
    }
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://prdownloads.sourceforge.net/tcl/tk8.6.18-src.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "patch",
        "filename": "darwin-x11.diff",
        "p_num": "1"
      },
      {
        "cmd": "env_variable",
        "name": "TK_CONFIGURE",
        "op": "set",
        "value": "$SOURCE_DIR/unix/configure"
      },
      {
        "cmd": "unpack",
        "as": "tk",
        "shared": "tk-8.6.18",
        "select": true
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "env_variable",
        "name": "CFLAGS",
        "op": "prepend",
        "value": "-I$INSTALL_DIR/include"
      },
      {
        "cmd": "configure",
        "path": "$TK_CONFIGURE",
        "options": [
          {
            "name": "srcdir",
            "value": "$SOURCE_DIR/unix"
          },
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "disable-shared",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
