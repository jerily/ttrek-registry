{
  "name": "tk",
  "description": "Cross-platform graphical user interface toolkit for Tcl.",
  "version": "8.6.18",
  "scripts": {
    "demo-widgets": {
      "file": "demo-widgets.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.18,<8.7.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://prdownloads.sourceforge.net/tcl/tk8.6.18-src.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "patch",
        "filename": "darwin-x11.diff",
        "p_num": "1"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "configure",
        "path": "$SOURCE_DIR/unix/configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "disable-shared",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
