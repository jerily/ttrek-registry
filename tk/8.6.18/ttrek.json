{
  "name": "tk",
  "license": "TCL",
  "description": "Cross-platform graphical user interface toolkit for Tcl.",
  "tags": ["tcl", "tk", "gui", "widgets"],
  "url": "https://github.com/tcltk/tk",
  "version": "8.6.18",
  "scripts": {
    "demo-widgets": {
      "file": "demo-widgets.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.18,<8.7.0"
  },
  "externalDependencies": {
    "xquartz": {
      "platforms": [
        "darwin"
      ],
      "check": {
        "files": [
          "/opt/X11/include/X11/Xlib.h",
          "/opt/X11/lib/libX11.dylib"
        ]
      },
      "installHint": "brew install --cask xquartz",
      "url": "https://www.xquartz.org/"
    }
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://prdownloads.sourceforge.net/tcl/tk8.6.18-src.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "patch",
        "filename": "darwin-x11.diff",
        "p_num": "1"
      },
      {
        "cmd": "patch",
        "filename": "private-default-header.diff",
        "p_num": "1"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "configure",
        "path": "$SOURCE_DIR/unix/configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "disable-shared",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      },
      {
        "cmd": "make_install",
        "target": "install-private-headers",
        "options": [
          {
            "name": "PRIVATE_INCLUDE_DIR",
            "value": "$INSTALL_DIR/include"
          }
        ]
      }
    ]
  }
}
