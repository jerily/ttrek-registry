--- a/unix/configure.ac
+++ b/unix/configure.ac
@@ -259,6 +259,15 @@
     #	autoconf macro will return an include directory that contains
     #	no include files, so double-check its result just to be safe.
     #--------------------------------------------------------------------
+
+    # XQuartz libraries may be outside the default linker search path.
+    case $system in
+        Darwin-*)
+            if tk_x11_libs=`pkg-config --libs x11 2>/dev/null`; then
+                LDFLAGS="$LDFLAGS $tk_x11_libs"
+            fi
+            ;;
+    esac
 
