{
  "name": "tkhtml",
  "version": "3.0.0",
  "description": "HTML and CSS rendering widget for Tk.",
  "url": "https://github.com/olebole/tkhtml3",
  "license": "BSD-3-Clause",
  "languages": [
    "Tcl",
    "C"
  ],
  "tags": [
    "tcl",
    "tk",
    "html",
    "css"
  ],
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.18,<8.7.0",
    "tk": ">=8.6.18,<8.7.0"
  },
  "externalDependencies": {
    "xquartz": {
      "platforms": [
        "darwin"
      ],
      "check": {
        "files": [
          "/opt/X11/include/X11/Xlib.h",
          "/opt/X11/lib/libX11.dylib"
        ]
      },
      "installHint": "brew install --cask xquartz",
      "url": "https://www.xquartz.org/"
    }
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/olebole/tkhtml3/archive/e6bf0ab04a8cf967452283be23533154c1982978.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "patch",
        "filename": "xquartz.diff",
        "p_num": "1"
      },
      {
        "cmd": "autogen",
        "path": "chmod",
        "options": [
          {
            "name": "+x"
          },
          {
            "name": "configure"
          }
        ]
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "env_variable",
        "name": "CPPFLAGS",
        "op": "prepend",
        "value": "-I$INSTALL_DIR/include"
      },
      {
        "cmd": "env_variable",
        "name": "LDFLAGS",
        "op": "prepend",
        "value": "-L$INSTALL_DIR/lib -Wl,-rpath,$INSTALL_DIR/lib"
      },
      {
        "cmd": "env_variable",
        "name": "CFLAGS",
        "op": "append",
        "value": "-std=gnu17"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "with-tk",
            "value": "$INSTALL_DIR/lib"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
