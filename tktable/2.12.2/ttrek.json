{
  "name": "tktable",
  "version": "2.12.2",
  "description": "Editable table widget for Tk.",
  "url": "https://github.com/bohagan1/TkTable",
  "license": "TCL AND BSD-2-Clause",
  "languages": [
    "Tcl",
    "C"
  ],
  "tags": [
    "tcl",
    "tk",
    "gui",
    "table"
  ],
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.18,<8.7.0",
    "tk": ">=8.6.18,<8.7.0",
    "tcllib": "^2.0.0"
  },
  "externalDependencies": {
    "xquartz": {
      "platforms": [
        "darwin"
      ],
      "check": {
        "files": [
          "/opt/X11/include/X11/Xlib.h",
          "/opt/X11/lib/libX11.dylib"
        ]
      },
      "installHint": "brew install --cask xquartz",
      "url": "https://www.xquartz.org/"
    }
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/bohagan1/TkTable/releases/download/tktable-2-12-2/Tktable2.12.2.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "env_variable",
        "name": "CPPFLAGS",
        "op": "prepend",
        "value": "-I$INSTALL_DIR/include"
      },
      {
        "cmd": "env_variable",
        "name": "LDFLAGS",
        "op": "prepend",
        "value": "-L$INSTALL_DIR/lib -Wl,-rpath,$INSTALL_DIR/lib"
      },
      {
        "cmd": "env_variable",
        "name": "CPPFLAGS",
        "op": "append",
        "value": "-I/opt/X11/include"
      },
      {
        "cmd": "env_variable",
        "name": "LDFLAGS",
        "op": "append",
        "value": "-L/opt/X11/lib -Wl,-rpath,/opt/X11/lib"
      },
      {
        "cmd": "env_variable",
        "name": "PKG_CONFIG_PATH",
        "op": "set",
        "value": "${PKG_CONFIG_PATH:+${PKG_CONFIG_PATH}:}/opt/X11/lib/pkgconfig:/opt/X11/share/pkgconfig"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "with-tk",
            "value": "$INSTALL_DIR/lib"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
