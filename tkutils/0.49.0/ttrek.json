  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/gregnix/tkutils/archive/6a05777a825443883b9054954ae8f0d2a4a0c366.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "patch",
        "filename": "install.diff",
        "p_num": "1"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "make_install",
        "options": [
          {
            "name": "prefix",
            "value": "$INSTALL_DIR"
          }
        ]
      }
    ]
  }
