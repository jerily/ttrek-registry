{
  "name": "tls",
  "version": "2.0.1",
  "description": "TLS channels for Tcl, backed by OpenSSL.",
  "url": "https://github.com/bohagan1/TclTLS",
  "license": "TCL",
  "languages": [
    "Tcl",
    "C"
  ],
  "tags": [
    "tcl",
    "tls",
    "openssl",
    "networking"
  ],
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.18,<8.7.0",
    "openssl": "^3.5.9",
    "tcllib": "^2.0.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/bohagan1/TclTLS/releases/download/tls-2.0.1/tcltls2.0.1.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "env_variable",
        "name": "CPPFLAGS",
        "op": "prepend",
        "value": "-I$INSTALL_DIR/include"
      },
      {
        "cmd": "env_variable",
        "name": "LDFLAGS",
        "op": "prepend",
        "value": "-L$INSTALL_DIR/lib -Wl,-rpath,$INSTALL_DIR/lib"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "with-openssl-dir",
            "value": "$INSTALL_DIR"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
