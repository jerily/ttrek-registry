{
  "name": "tmfa",
  "license": "MIT",
  "description": "HOTP, TOTP, and Base32 for Tcl using OpenSSL.",
  "tags": ["tcl", "authentication", "mfa", "totp", "hotp", "security"],
  "url": "https://github.com/jerily/tmfa",
  "version": "1.1.1",
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "openssl": "^3.0.13",
    "tcl": ">=8.6.14"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tmfa/archive/refs/tags/v1.1.1.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "CMAKE_BUILD_TYPE",
            "value": "Release"
          },
          {
            "name": "TCL_LIBRARY_DIR",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "TCL_INCLUDE_PATH",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "OPENSSL_ROOT_DIR",
            "value": "$INSTALL_DIR"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "OFF",
            "if": "+static"
          },
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "parallel": true
      },
      {
        "cmd": "cmake_install"
      }
    ]
  }
}
