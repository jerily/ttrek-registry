{
  "name": "tpersist-sqlite",
  "license": "MIT",
  "description": "SQLite connection adapter for tpersist.",
  "languages": [
    "TCL"
  ],
  "url": "https://github.com/jerily/tpersist-sqlite",
  "version": "0.1.9",
  "dependencies": {
    "tdbcsqlite3": ">=1.1.8"
  },
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tpersist-sqlite/archive/refs/tags/v0.1.9.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "make_install",
        "options": [
          {
            "name": "PREFIX",
            "value": "$INSTALL_DIR"
          }
        ]
      }
    ]
  }
}
