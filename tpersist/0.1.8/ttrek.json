{
  "name": "tpersist",
  "license": "MIT",
  "description": "SQL queries, versioned schemas, and JSONL schema/data backups through TDBC for Tcl.",
  "languages": [
    "C",
    "TCL"
  ],
  "tags": [
    "tcl",
    "tdbc",
    "sql",
    "database",
    "persistence",
    "json"
  ],
  "url": "https://github.com/jerily/tpersist",
  "version": "0.1.8",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.14",
    "tjson": "^1.0.30"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tpersist/archive/refs/tags/v0.1.8.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "TCL_LIBRARY_DIR",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "TCL_INCLUDE_PATH",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "ON"
          },
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "config": "Release",
        "parallel": true
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
