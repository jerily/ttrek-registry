{
  "name": "tqrcodegen",
  "description": "Generate QR codes as SVG images from Tcl.",
  "tags": ["tcl", "qr-code", "svg", "graphics"],
  "url": "https://github.com/jerily/tqrcodegen",
  "version": "1.1.1",
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.14"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tqrcodegen/archive/refs/tags/v1.1.1.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "TCL_LIBRARY_DIR",
            "value": "$INSTALL_DIR/lib"
          },
          {
            "name": "TCL_INCLUDE_PATH",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "OFF",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "parallel": true
      },
      {
        "cmd": "cmake_install"
      }
    ]
  }
}
