{
  "name": "treqmon",
  "license": "MIT",
  "description": "HTTP request monitoring with configurable Jinja layouts and tpathexp routes.",
  "tags": [
    "tcl",
    "http",
    "web",
    "monitoring",
    "middleware"
  ],
  "url": "https://github.com/jerily/treqmon",
  "version": "2.2.0",
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "valkey-tcl": ">=1.0.1",
    "twebserver": ">=1.47.53",
    "jinja2-tcl": "^0.1.0",
    "tjson": ">=1.0.26",
    "thread": ">=2.8.9",
    "tpathexp": "^1.2.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/treqmon/archive/refs/tags/v2.2.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "make_install",
        "options": [
          {
            "name": "PREFIX",
            "value": "$INSTALL_DIR"
          }
        ]
      }
    ]
  }
}
