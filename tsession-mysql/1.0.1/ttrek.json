{
  "name": "tsession-mysql",
  "version": "1.0.1",
  "license": "MIT",
  "description": "MySQL session storage for tsession.",
  "dependencies": {
    "tcl": ">=8.6.14",
    "tsession": "^2.0.3",
    "tpersist-mysql": "^0.1.8"
  },
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tsession-mysql/archive/refs/tags/v1.0.1.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  },
  "url": "https://github.com/jerily/tsession-mysql"
}
