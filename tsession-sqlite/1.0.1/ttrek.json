{
  "name": "tsession-sqlite",
  "license": "MIT",
  "version": "1.0.1",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.14",
    "tsession": "^2.0.0",
    "tpersist": "^0.1.4",
    "tdbcsqlite3": ">=1.1.8"
  },
  "devDependencies": {},
  "description": "SQLite session persistence for tsession, with tenant isolation and shared transactions.",
  "tags": ["tcl", "web", "sessions", "sqlite", "sql", "persistence"],
  "url": "https://github.com/jerily/tsession-sqlite",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tsession-sqlite/releases/download/v1.0.1/tsession-sqlite-1.0.1.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
