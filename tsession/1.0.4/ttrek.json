{
  "name": "tsession",
  "description": "Session management middleware for Tcl web applications.",
  "url": "https://github.com/jerily/tsession",
  "version": "1.0.4",
  "scripts": {},
  "dependencies": {
    "tink-tcl": "^20240704.0.2",
    "twebserver": "^1.47.56",
    "tcl": ">=8.6.14",
    "thread": ">=3.0.7"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tsession/archive/refs/tags/v1.0.4.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "make_install",
        "options": [
          {
            "name": "PREFIX",
            "value": "$INSTALL_DIR"
          }
        ]
      }
    ]
  }
}
