{
  "name": "tsession",
  "license": "MIT",
  "description": "Per-mount signed cookies and tenant-scoped SQL sessions for Tcl.",
  "tags": ["tcl", "web", "sessions", "cookies", "sql"],
  "url": "https://github.com/jerily/tsession",
  "version": "2.0.1",
  "scripts": {},
  "dependencies": {
    "tpersist": "^0.1.4",
    "tink-tcl": "^20240704.0.2",
    "twebserver": "^1.47.56",
    "tcl": ">=8.6.14"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tsession/archive/refs/tags/v2.0.1.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "make_install",
        "options": [
          {
            "name": "PREFIX",
            "value": "$INSTALL_DIR"
          }
        ]
      }
    ]
  }
}
