{
  "name": "ttrie",
  "license": "MIT",
  "description": "String trie with exact lookup and edit-distance search for C and Tcl.",
  "tags": ["tcl", "c", "search", "trie", "fuzzy-search"],
  "url": "https://github.com/jerily/ttrie",
  "version": "0.1.1",
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.14"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/ttrie/releases/download/v0.1.1/ttrie-0.1.1.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "CMAKE_INSTALL_LIBDIR",
            "value": "lib"
          },
          {
            "name": "TCL_INCLUDE_PATH",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "OFF",
            "if": "+static"
          },
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "config": "Release",
        "parallel": true
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
