{
  "name": "udp",
  "version": "1.0.14",
  "description": "UDP sockets for Tcl.",
  "url": "https://core.tcl-lang.org/tcludp/",
  "license": "MIT",
  "languages": [
    "Tcl",
    "C"
  ],
  "tags": [
    "tcl",
    "networking",
    "udp"
  ],
  "scripts": {
    "demo": {
      "file": "demo.sh"
    }
  },
  "dependencies": {
    "tcl": ">=8.6.18,<8.7.0",
    "tcllib": "^2.0.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://core.tcl-lang.org/tcludp/uv/tcludp1.0.14.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "env_variable",
        "name": "CPPFLAGS",
        "op": "prepend",
        "value": "-I$INSTALL_DIR/include"
      },
      {
        "cmd": "env_variable",
        "name": "LDFLAGS",
        "op": "prepend",
        "value": "-L$INSTALL_DIR/lib -Wl,-rpath,$INSTALL_DIR/lib"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
