{
  "name": "web-blog",
  "version": "0.1.2",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.0,<10.0.0",
    "tpersist": "^0.1.0",
    "tpathexp": "^1.1.0",
    "cmark-gfm-tcl": "^0.1.0",
    "tdbcsqlite3": ">=1.1.8",
    "jinja2-tcl": "^0.1.0",
    "tjson": "^1.0.26"
  },
  "devDependencies": {},
  "description": "Editable Markdown blog for Tcl with SQLite persistence.",
  "url": "https://github.com/jerily/web-blog",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/web-blog/releases/download/v0.1.2/web-blog-0.1.2.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
