{
  "name": "web-core",
  "license": "MIT",
  "version": "0.1.0",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.0,<10.0.0",
    "tjson": "^1.0.30",
    "tpathexp": "^1.2.0"
  },
  "devDependencies": {},
  "description": "Read installed web package manifests and register routes and middleware on a Tcl router.",
  "languages": [
    "TCL"
  ],
  "tags": [
    "tcl",
    "web",
    "routing"
  ],
  "url": "https://github.com/jerily/web-core",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/web-core/archive/refs/tags/v0.1.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
