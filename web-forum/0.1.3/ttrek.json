{
  "name": "web-forum",
  "version": "0.1.3",
  "scripts": {},
  "dependencies": {
    "tcl": ">=9.1.0,<10.0.0",
    "web-user": "=0.1.3",
    "cmark-gfm-tcl": "^0.1.0",
    "topenapi": "^0.2.0"
  },
  "devDependencies": {},
  "description": "Markdown discussions with a visual editor and authenticated posting.",
  "url": "https://github.com/jerily/web-forum",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/web-forum/releases/download/v0.1.3/web-forum-0.1.3.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
