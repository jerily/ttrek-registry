{
  "name": "web-forum",
  "license": "MIT",
  "version": "0.2.0",
  "scripts": {},
  "dependencies": {
    "tpersist": "^0.1.4",
    "tcl": ">=9.1.0,<10.0.0",
    "web-user": "^0.5.0",
    "cmark-gfm-tcl": "^0.1.0",
    "topenapi": "^0.2.0",
    "tcaptcha": "^0.1.0"
  },
  "devDependencies": {},
  "description": "Markdown discussions with moderation, CAPTCHA, public profiles, and pagination.",
  "tags": [
    "tcl",
    "web",
    "forum",
    "markdown",
    "community"
  ],
  "url": "https://github.com/jerily/web-forum",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/web-forum/releases/download/v0.2.0/web-forum-0.2.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
