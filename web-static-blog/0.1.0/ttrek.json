{
  "name": "web-static-blog",
  "license": "MIT",
  "version": "0.1.0",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.0,<10.0.0",
    "tpathexp": "^1.1.0",
    "cmark-gfm-tcl": "^0.1.0",
    "jinja2-tcl": "^0.1.0",
    "tjson": "^1.0.26"
  },
  "devDependencies": {},
  "description": "Read-only Markdown blog served from a directory with Jinja templates.",
  "tags": ["tcl", "web", "blog", "markdown", "static-site"],
  "url": "https://github.com/jerily/web-static-blog",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/web-static-blog/archive/e92656bdb25e25dde636db673390ccd470c4fc28.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
