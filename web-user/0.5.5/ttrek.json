{
  "name": "web-user",
  "license": "MIT",
  "version": "0.5.5",
  "iuse": [
    "local"
  ],
  "scripts": {},
  "dependencies": {
    "tcl": ">=9.1.0,<10.0.0",
    "tpersist": "^0.1.5",
    "tpathexp": "^1.1.0",
    "jinja2-tcl": "^0.1.1",
    "tjson": "^1.0.27",
    "tink-tcl": "20240704.0.2",
    "tmfa": "1.1.2",
    "tqrcodegen": "^1.1.1",
    "ksuid-tcl": "^1.0.5",
    "tdbcsqlite3": {
      "version": ">=1.1.8",
      "if": "+local"
    },
    "tdbcpostgres": {
      "version": ">=1.1.8",
      "if": "-local"
    },
    "bcrypt-tcl": "2.0.1",
    "twebserver": "^1.47.56",
    "tsession": "^2.0.1",
    "topenapi": "^0.2.0",
    "tsession-sqlite": {
      "version": "^1.0.2",
      "if": "+local"
    },
    "tsession-postgres": {
      "version": "^1.0.2",
      "if": "-local"
    },
    "pure-tcl-aws-ses": "^1.0.0",
    "pure-tcl-aws-sqs": "^1.0.0",
    "tcaptcha": "^1.0.0"
  },
  "devDependencies": {},
  "description": "Accounts, recovery, MFA, and configured groups and permissions for Tcl sites.",
  "languages": [
    "TCL"
  ],
  "tags": [
    "tcl",
    "web",
    "authentication",
    "accounts",
    "mfa",
    "authorization"
  ],
  "url": "https://github.com/jerily/web-user",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/web-user/archive/refs/tags/v0.5.5.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
