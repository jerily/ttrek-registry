{
  "name": "web-wiki",
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {},
  "dependencies": {
    "web-core": "^0.1.0",
    "tcl": ">=8.6.0,<10.0.0",
    "tpersist": "^0.1.4",
    "tpathexp": "^1.1.0",
    "cmark-gfm-tcl": "^0.1.0",
    "tdbcsqlite3": ">=1.1.8",
    "jinja2-tcl": "^0.1.0",
    "tjson": "^1.0.26"
  },
  "devDependencies": {},
  "description": "Editable Markdown wiki with host authorization and shared image rendering.",
  "languages": [
    "TCL"
  ],
  "tags": [
    "tcl",
    "web",
    "wiki",
    "markdown",
    "sqlite"
  ],
  "url": "https://github.com/jerily/web-wiki",
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/web-wiki/archive/refs/tags/v1.0.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
